# Copia in .env.production.local per personalizzare la build di produzione (npm run build).

# URL pubblico del sito: viene scritto negli adesivi/braccialetti NFC e nei QR.
# Se lasci vuoto si usa l'indirizzo da cui è aperta l'app.
VITE_PUBLIC_URL=https://www.tuodominio.it

# Nome mostrato nel logo.
VITE_APP_NAME=Party Casinò

# Solo se l'app NON sta nella root del dominio: sottocartella con barre (es. /party/).
# VITE_BASE si imposta come variabile d'ambiente al momento della build: VITE_BASE=/party/ npm run build
