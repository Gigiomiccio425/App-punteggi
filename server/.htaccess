# Party Casinò — configurazione Apache per Aruba Hosting Linux (o qualsiasi hosting con mod_rewrite)
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS obbligatorio per l'NFC dal browser (Web NFC funziona solo su https://).
  # Aruba include il certificato SSL: se il pannello non forza già https, togli il "#" alle 3 righe seguenti.
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- API PHP
  RewriteCond %{REQUEST_URI} !/api/index\.php$
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # --- File di configurazione e database: mai serviti
  RewriteRule (^|/)\.(?!well-known) - [F]
  RewriteRule \.(sqlite|sqlite-journal|db)$ - [F]

  # --- Single Page App: tutte le altre rotte (es. /tavolo/..., /j/CODICE/TOKEN) aprono index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(js|css|woff2?|svg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
