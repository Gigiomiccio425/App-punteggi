{
  "name": "party-casino",
  "private": true,
  "version": "0.1.0",
  "description": "Party Casinò: web app per serate di gioco con fiches virtuali, vite e punti. Frontend React, API PHP + SQLite per hosting condiviso (Aruba Linux Basic), NFC via Web NFC su Android e codice manuale su iPhone.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "PC_DATA_DIR=.data php -S 127.0.0.1:8000 -t server server/dev-router.php",
    "dev:server": "VITE_BACKEND=api vite",
    "build": "tsc --noEmit && vite build && node scripts/package-aruba.mjs",
    "build:demo": "tsc --noEmit && VITE_BACKEND=demo vite build",
    "preview:aruba": "PC_DATA_DIR=.data php -S 127.0.0.1:8080 -t dist server/dev-router.php",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
